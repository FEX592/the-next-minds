{
  "buildCommand": "vite build",
  "outputDirectory": "dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/manus-storage/(.*)",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/programs",
      "destination": "/api"
    },
    {
      "source": "/programs/:slug",
      "destination": "/api"
    },
    {
      "source": "/partner",
      "destination": "/api"
    },
    {
      "source": "/contact",
      "destination": "/api"
    },
    {
      "source": "/register",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/public/index.html"
    }
  }
}
